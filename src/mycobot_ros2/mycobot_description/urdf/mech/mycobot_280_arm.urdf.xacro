<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- xacro 内部变量 -->

    <!-- 1. 关节最大力矩(N·m)，用于 joint limit 限制 -->
    <xacro:property name="joint_effort" value="56.0"/>
    <!-- 2. 关节最大角速度(rad/s)，用于 joint limit 限制 -->
    <xacro:property name="joint_velocity" value="2.792527"/>
    <!-- 3. 关节阻尼系数，Gazebo 动力学 dynamics 标签使用 -->
    <xacro:property name="joint_damping" value="0.0"/>
    <!-- 4. 关节库伦摩擦系数，Gazebo 动力学 dynamics 标签使用 -->
    <xacro:property name="joint_friction" value="0.0"/>

    <!-- 1. 连杆 1 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link1_mass" value="0.12"/>
    <!-- 2. 连杆 2 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link2_mass" value="0.19"/>
    <!-- 3. 连杆 3 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link3_mass" value="0.16"/>
    <!-- 4. 连杆 4 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link4_mass" value="0.124"/>
    <!-- 5. 连杆 5 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link5_mass" value="0.11"/>
    <!-- 6. 连杆 6 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="link6_mass" value="0.0739"/>
    <!-- 7. 末端法兰 质量，单位 kg，用于 inertial 惯性参数 -->
    <xacro:property name="flange_mass" value="0.035"/> 

    <!-- 
        1. 宏定义: 生成连杆惯性块 
        参数:
            1) mass: 质量, 表示这个 Link 有多重, kg
            2) ixx: 绕 x轴 的转动惯量, 表示绕 x 轴转有多难, kg·m²
            2) iyy: 绕 y轴 的转动惯量, 表示绕 y 轴转有多难, kg·m²
            2) izz: 绕 z轴 的转动惯量, 表示绕 z 轴转有多难, kg·m²
    -->
    <xacro:macro name="link_inertial" params="mass ixx iyy izz">

        <!-- 连杆惯性块 -->
        <inertial>
            
            <!-- 1. 惯性坐标系 相对于 连杆坐标系 的 位置 和 位姿 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

            <!-- 2. 连杆质量(kg) -->
            <mass value="${mass}"/>

            <!-- 3. 惯性张量矩阵 -->
            <inertia
                ixx="${ixx}" ixy="0.0" ixz="0.0"
                iyy="${iyy}" iyz="0.0" izz="${izz}"
            />

        </inertial>

    </xacro:macro>

    <!-- 2. 宏定义: 给 Gazebo 中指定连杆设置视觉材质(仅在Gazebo中生效) -->
    <!-- 
        参数:
            1) ref_link: 指定要修改的目标连杆名称
            2）ambient: 环境光颜色, RGBA
            3）diffuse: 漫反射颜色, RGBA
            4）specular: 高光反射颜色, RGBA
    -->
    <xacro:macro name="material_visual" params="ref_link ambient diffuse specular">

        <!-- 指定 Gazebo 渲染的 连杆 -->
        <gazebo reference="${ref_link}">

            <!-- Gazebo 视觉渲染配置, 和 URDF 的 visual 相互独立 -->
            <visual>
 
                <!-- 材质定义 -->
                <material>
                    
                    <!-- 环境光颜色，环境照射到物体上的基础底色 RGBA -->
                    <ambient>${ambient}</ambient>

                    <!-- 漫反射颜色，物体受光呈现的主体颜色 RGBA -->
                    <diffuse>${diffuse}</diffuse>

                    <!-- 高光颜色，光源直射产生的反光亮点 RGBA -->
                    <specular>${specular}</specular>                 

                </material>

            </visual>

        </gazebo>

    </xacro:macro>

    <!-- 3. 宏定义: 批量生成 link & joint  -->
    <xacro:macro name="mycobot_280_arm" params="base_link flange_link prefix *origin">

        <!-- 1 号连杆 -->
        <link name="${prefix}link1">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link1_mass}"
                ixx="0.000148" iyy="0.000148" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link1.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 0" rpy="0 0 ${-pi/2}"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <box size="0.08 0.12 0.075"/>
                </geometry>
                <origin xyz="0.0 -0.01 0.034" rpy="0 0 0"/>
            </collision>
        </link>

        <!-- 2 号连杆 -->
        <link name="${prefix}link2">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link2_mass}"
                ixx="0.000148" iyy="0.000148" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link2.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 -0.06096" rpy="0 0 ${-pi/2}"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <cylinder radius="0.025" length="0.085"/>
                </geometry>
                <origin xyz="0.0 0 -0.02" rpy="0 0 ${-pi/2}"/>
            </collision>
        </link>

        <!-- 3 号连杆 -->
        <link name="${prefix}link3">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link3_mass}"
                ixx="0.000148" iyy="0.000148" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link3.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 0.03256" rpy="0 ${-pi/2} 0"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <cylinder radius="0.025" length="0.15"/>
                </geometry>
                <origin xyz="-0.058 0 0.059" rpy="0 ${-pi/2} 0"/>
            </collision>
        </link>

        <!-- 4 号连杆 -->
        <link name="${prefix}link4">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link4_mass}" 
                ixx="0.000103" iyy="0.000103" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link4.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 0.03056" rpy="0 ${-pi/2} 0"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <cylinder radius="0.025" length="0.125"/>
                </geometry>
                <origin xyz="-0.05 0 0.0" rpy="0 ${-pi/2} 0"/>
            </collision>
        </link>

        <!-- 5 号连杆 -->
        <link name="${prefix}link5">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link5_mass}" 
                ixx="0.000103" iyy="0.000103" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link5.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 -0.03356" rpy="${-pi/2} 0 0"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <box size="0.03 0.035 0.05"/>
                </geometry>
                <origin xyz="0.0 0 -0.005" rpy="0 0.0 0"/>
            </collision>
        </link>

        <!-- 6 号连杆 -->
        <link name="${prefix}link6">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${link6_mass}" 
                ixx="0.00006649" iyy="0.00006649" izz="0.000096"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link6.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <cylinder radius="0.025" length="0.06"/>
                </geometry>
                <origin xyz="0 0.00 0.0" rpy="${-pi/2} 0 0"/>
            </collision>
        </link>

        <!-- 7 号连杆 -->
        <link name="${prefix}${flange_link}">
            <!-- 1) 调用惯性宏定义 -->
            <xacro:link_inertial 
                mass="${flange_mass}" 
                ixx="0.0000149" iyy="0.0000149" izz="0.0000196"
            />
            <!-- 2) 可视化 -->
            <visual>
                <!-- 使用 dae 网络模型 -->
                <geometry>
                    <mesh filename="file://$(find mycobot_description)/meshes/mycobot_280/visual/link7.dae" />
                </geometry>
                <!-- 定位 -->
                <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
            </visual>
            <!-- 3) 碰撞 -->
            <collision>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <origin xyz="0 0.00 0.0" rpy="0 0 0"/>
            </collision>
        </link>

        <!-- 1 号关节(baske_linkk, link1) -->
        <joint name="${prefix}${base_link}_to_${prefix}link1" type="fixed">
            <!-- 父节点 -->
            <parent link="${prefix}${base_link}"/>
            <!-- 子节点 -->
            <child link="${prefix}link1"/>
            <!-- 位置 -->
            <xacro:insert_block name="origin"/>
        </joint>

        <!-- 2 号关节(link1, link2) -->
        <joint name="${prefix}link1_to_${prefix}link2" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-2.879793" 
                upper="2.879793" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link1"/>
            <!-- 子节点 -->
            <child link="${prefix}link2"/>
            <!-- 位置 -->
            <origin xyz="0 0 0.13156" rpy="0 0 ${pi/2}"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>

        <!-- 3 号关节(link2, link3) -->
        <joint name="${prefix}link2_to_${prefix}link3" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-2.879793" 
                upper="2.879793" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link2"/>
            <!-- 子节点 -->
            <child link="${prefix}link3"/>
            <!-- 位置 -->
            <origin xyz="0 0 -0.001" rpy="0 ${pi/2} ${-pi/2}"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>

        <!-- 4 号关节(link3, link4) -->
        <joint name="${prefix}link3_to_${prefix}link4" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-2.879793" 
                upper="2.879793" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link3"/>
            <!-- 子节点 -->
            <child link="${prefix}link4"/>
            <!-- 位置 -->
            <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>

        <!-- 5 号关节(link4, link5) -->
        <joint name="${prefix}link4_to_${prefix}link5" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-2.879793" 
                upper="2.879793" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link4"/>
            <!-- 子节点 -->
            <child link="${prefix}link5"/>
            <!-- 位置 -->
            <origin xyz="-0.096 0 0.06062" rpy="0 0 ${-pi/2}"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>


        <!-- 6 号关节(link5, link6) -->
        <joint name="${prefix}link5_to_${prefix}link6" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-2.879793" 
                upper="2.879793" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link5"/>
            <!-- 子节点 -->
            <child link="${prefix}link6"/>
            <!-- 位置 -->
            <origin xyz="0 -0.07318 0" rpy="${pi/2} ${-pi/2} 0"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>


        <!-- 7 号关节(link6, link7) -->
        <joint name="${prefix}link6_to_${prefix}${flange_link}" type="revolute">
            <!-- 旋转方向 -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- 关节限位：最大力矩、角度上下限、最大角速度 -->
            <limit 
                effort="${joint_effort}" 
                lower="-3.05" 
                upper="3.05" 
                velocity="${joint_velocity}"/>
            <!-- 父节点 -->
            <parent link="${prefix}link6"/>
            <!-- 子节点 -->
            <child link="${prefix}${flange_link}"/>
            <!-- 位置 -->
            <origin xyz="0 0.0456 0" rpy="${-pi/2} 0 0"/>
            <!-- 动力学参数：阻尼、库伦摩擦，Gazebo仿真使用 -->
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
        </joint>

        <!-- 1. 调用材质宏：Gazebo渲染，设置 link1 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link1" 
            ambient="0.5 0.5 0.5 1" 
            diffuse="0.5 0.5 0.5 1" 
            specular="0.5 0.5 0.5 1"
        />
        <!-- 2. 调用材质宏：Gazebo渲染，设置 link2 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link2" 
            ambient="1 1 1 1" 
            diffuse="1 1 1 1" 
            specular="1 1 1 1"
        />
        <!-- 3. 调用材质宏：Gazebo渲染，设置 link3 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link3" 
            ambient="1 1 1 1" 
            diffuse="1 1 1 1" 
            specular="1 1 1 1"
        />
        <!-- 4. 调用材质宏：Gazebo渲染，设置 link4 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link4" 
            ambient="1 1 1 1" 
            diffuse="1 1 1 1" 
            specular="1 1 1 1"
        />
        <!-- 5. 调用材质宏：Gazebo渲染，设置 link5 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link5" 
            ambient="1 1 1 1" 
            diffuse="1 1 1 1" 
            specular="1 1 1 1"
        />
        <!-- 6. 调用材质宏：Gazebo渲染，设置 link6 材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}link6" 
            ambient="1 1 1 1" 
            diffuse="1 1 1 1" 
            specular="1 1 1 1"
        />
        <!-- 7. 调用材质宏：Gazebo渲染，设置末端法兰材质颜色 -->
        <xacro:material_visual 
            ref_link="${prefix}${flange_link}" 
            ambient="0.5 0.5 0.5 1" 
            diffuse="0.5 0.5 0.5 1" 
            specular="0.5 0.5 0.5 1"
        />

    </xacro:macro>

</robot>