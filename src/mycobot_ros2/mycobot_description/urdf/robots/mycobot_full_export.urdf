  <gazebo reference="link1">
    <!-- Gazebo 视觉渲染配置, 和 URDF 的 visual 相互独立 -->
    <visual>
      <!-- 材质定义 -->
      <material>
        <!-- 环境光颜色，环境照射到物体上的基础底色 RGBA -->
        <ambient>0.5 0.5 0.5 1</ambient>
        <!-- 漫反射颜色，物体受光呈现的主体颜色 RGBA -->
        <diffuse>0.5 0.5 0.5 1</diffuse>
