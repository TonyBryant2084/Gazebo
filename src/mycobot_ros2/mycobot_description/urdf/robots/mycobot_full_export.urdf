      </material>
    </visual>
  </gazebo>
  <!-- 4. 添加末端夹爪 -->
  <!-- 引入自适应夹爪模型 -->
  <!-- 调用宏文件，挂载到法兰连杆 -->
  <!-- ========== 1.夹爪底座连杆 gripper_base ========== -->
  <link name="gripper_base">
    <!-- 底座惯性参数，底座质量0.07kg，单独定义，不使用手指宏 -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <mass value="0.07"/>
      <inertia ixx="0.000010725" ixy="0.0" ixz="0.0" iyy="0.000014392" iyz="0.0" izz="0.000018517"/>
    </inertial>
    <!-- Visual 可视化模型：仅用于RViz显示，不参与碰撞仿真 -->
    <visual>
      <geometry>
        <!-- 加载dae网格模型，文件路径在mycobot_description包下 -->
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_base.dae"/>
      </geometry>
      <!-- 网格模型相对于link坐标系的偏移位姿 -->
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.012"/>
    </visual>
    <!-- Collision 碰撞模型：Gazebo碰撞检测用，一般用简化box代替精细mesh，提升仿真速度 -->
    <collision>
      <geometry>
        <!-- 简化包围盒：长宽高 0.065m ×0.025m ×0.025m -->
        <box size="0.065 0.025 0.025"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>
  <!-- 固定关节：机械臂末端法兰(parent) 固定连接 夹爪底座gripper_base -->
  <joint name="link6_flange_to_gripper_base" type="fixed">
    <parent link="link6_flange"/>
    <child link="gripper_base"/>
    <!-- 插入外部传入的origin位姿，宏调用时传入 -->
    <origin rpy="1.579 0.0 0.0" xyz="0.0 0.0 0.034"/>
  </joint>
  <!-- ========== 左侧手指三段连杆 ========== -->
  <!-- left1：左手指最外侧指尖段 -->
  <link name="gripper_left1">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_left1.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.039 -0.0133 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.013 0.02 0.015"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.013 0.042 -0.010"/>
    </collision>
  </link>
  <!-- left2：左手指中间段 -->
  <link name="gripper_left2">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_left2.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.005 -0.0195 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.025 0.0 -0.010"/>
    </collision>
  </link>
  <!-- left3：左手指根部段（主动关节所在连杆） -->
  <link name="gripper_left3">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_left3.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.012 0.0025 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.014 0.005 0.005"/>
    </collision>
  </link>
  <!-- ========== 右侧手指三段连杆 ========== -->
  <!-- right1：右手指最外侧指尖段 -->
  <link name="gripper_right1">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
