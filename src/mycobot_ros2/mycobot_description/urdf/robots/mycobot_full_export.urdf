      </geometry>
      <origin rpy="0 0 0" xyz="-0.039 -0.0133 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.013 0.02 0.015"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.013 0.042 -0.010"/>
    </collision>
  </link>
  <!-- right2：右手指中间段 -->
  <link name="gripper_right2">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_right2.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.005 -0.0195 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.025 0.0 -0.010"/>
    </collision>
  </link>
  <!-- right3：右手指根部段 -->
  <link name="gripper_right3">
    <inertial>
      <!-- 惯性原点：质心位置，这里简化设置在连杆坐标系原点 -->
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <!-- 连杆质量，引用上面定义的变量 -->
      <mass value="0.007"/>
      <!-- 惯性张量，非对角项全部置0，主轴对齐 -->
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/tony/Gazebo/install/mycobot_description/share/mycobot_description/meshes/adaptive_gripper/visual/gripper_right3.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.012 0.0025 -0.012"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.014 0.005 0.005"/>
    </collision>
  </link>
  <!-- ===================== 关节定义（核心：1个主动关节 + 5个mimic随动关节） ===================== -->
  <!-- 【唯一主动驱动关节】夹爪控制器关节，ros2_control只需要控制这一个关节 -->
  <joint name="gripper_controller" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- 旋转轴：Z轴，绕Z转动 -->
    <!-- limit：关节限位，effort最大力矩，lower/upper角度范围(rad)，velocity最大速度 -->
    <limit effort="56.0" lower="-0.7" upper="0.15" velocity="2.792527"/>
    <parent link="gripper_base"/>
    <child link="gripper_left3"/>
    <origin rpy="0 0 0" xyz="-0.012 0.005 0"/>
    <!-- 关节动力学参数：阻尼、摩擦 -->
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- 左手指中间段left2：mimic跟随主动关节，multiplier=1，角度同步同方向 -->
  <joint name="gripper_base_to_gripper_left2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-0.8" upper="0.5" velocity="2.792527"/>
    <parent link="gripper_base"/>
    <child link="gripper_left2"/>
    <origin rpy="0 0 0" xyz="-0.005 0.027 0"/>
    <!-- mimic：复刻关节，角度 = multiplier * 参考关节角度 + offset -->
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- left3 -> left1指尖关节：multiplier=-1，反向跟随，实现连杆耦合折叠 -->
  <joint name="gripper_left3_to_gripper_left1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-0.5" upper="0.5" velocity="2.792527"/>
    <parent link="gripper_left3"/>
    <child link="gripper_left1"/>
    <origin rpy="0 0 0" xyz="-0.027 0.016 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- 右侧根部right3：multiplier=-1，与主动关节反向，实现左右对向夹紧 -->
  <joint name="gripper_base_to_gripper_right3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-0.15" upper="0.7" velocity="2.792527"/>
    <parent link="gripper_base"/>
    <child link="gripper_right3"/>
    <origin rpy="0 0 0" xyz="0.012 0.005 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- 右手指中间段right2：multiplier=-1反向跟随 -->
  <joint name="gripper_base_to_gripper_right2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-0.5" upper="0.8" velocity="2.792527"/>
    <parent link="gripper_base"/>
    <child link="gripper_right2"/>
    <origin rpy="0 0 0" xyz="0.005 0.027 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- right3 -> right1指尖关节：multiplier=1同向跟随 -->
  <joint name="gripper_right3_to_gripper_right1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-0.5" upper="0.5" velocity="2.792527"/>
    <parent link="gripper_right3"/>
    <child link="gripper_right1"/>
    <origin rpy="0 0 0" xyz="0.027 0.016 0"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Gazebo插件配置：给夹爪底座设置Gazebo渲染材质，仅Gazebo识别，RViz忽略 -->
  <gazebo reference="gripper_base">
    <visual>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <specular>1 1 1 1</specular>
      </material>
    </visual>
  </gazebo>
  <!-- 5. 引入 Gazebo ros2_control 仿真插件配置文件 -->
  <!-- 调用 Gazebo ros2_control 宏文件，根据 use_gazebo 开关启用 仿真控制器 -->
  <!-- Gazebo 专属标签，内部配置 Gazebo 仿真插件， 让机器人模型带上 Gazebo 的 ros2_control 插件 -->
  <gazebo>
    <!-- filename：要加载哪个插件库；name：这个插件库里面要实例化哪个插件类 -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- 控制器参数文件路径，ros2_control从中读取关节控制器配置 -->
      <parameters>/home/tony/Gazebo/install/mycobot_moveit2_config/share/mycobot_moveit2_config/config/mycobot_280/ros2_controllers.yaml</parameters>
      <!-- ROS2话题重映射 -->
      <ros>
        <!-- 重映射：controller_manager读取的robot_description，使用全局/robot_description -->
        <remapping>/controller_manager/robot_description:=/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>
  <!-- 6. 引入 mycobot280 ros2_control 硬件接口、关节控制器配置 -->
  <!-- 调用 mycobot280 ros2_control 宏文件，配置关节控制器、状态发布器 -->
  <!-- 定义 ros2_control 硬件系统 -->
  <ros2_control name="RobotSystem" type="system">
    <!-- 配置硬件接口 -->
    <hardware>
      <!-- 连接 ros2_control 与 Gazebo -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- 1号关节，控制 link1 到 link2 -->
    <joint name="link1_to_link2">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-2.879793 rad -->
        <param name="min">-2.879793</param>
        <!-- 关节最大位置：2.879793 rad -->
        <param name="max">2.879793</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 2号关节，控制 link2 到 link3 -->
    <joint name="link2_to_link3">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-2.879793 rad -->
        <param name="min">-2.879793</param>
        <!-- 关节最大位置：2.879793 rad -->
        <param name="max">2.879793</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 3号关节，控制 link3 到 link4 -->
    <joint name="link3_to_link4">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-2.879793 rad -->
        <param name="min">-2.879793</param>
        <!-- 关节最大位置：2.879793 rad -->
        <param name="max">2.879793</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 4号关节，控制 link4 到 link5 -->
    <joint name="link4_to_link5">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-2.879793 rad -->
        <param name="min">-2.879793</param>
        <!-- 关节最大位置：2.879793 rad -->
        <param name="max">2.879793</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 5号关节，控制 link5 到 link6 -->
    <joint name="link5_to_link6">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-2.879793 rad -->
        <param name="min">-2.879793</param>
        <!-- 关节最大位置：2.879793 rad -->
        <param name="max">2.879793</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 6号关节，控制 link6 到末端法兰 -->
    <joint name="link6_to_link6_flange">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 关节最小位置：-3.05 rad -->
        <param name="min">-3.05</param>
        <!-- 关节最大位置：3.05 rad -->
        <param name="max">3.05</param>
      </command_interface>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
    </joint>
    <!-- 主夹爪关节，用于控制夹爪开合 -->
    <joint name="gripper_controller">
      <!-- 定义位置控制接口 -->
      <command_interface name="position">
        <!-- 夹爪最小位置：-0.7 rad -->
        <param name="min">-0.7</param>
        <!-- 夹爪最大位置：0.15 rad -->
        <param name="max">0.15</param>
      </command_interface>
      <!-- 读取当前夹爪位置 -->
      <state_interface name="position"/>
      <!-- 读取当前夹爪速度 -->
      <state_interface name="velocity"/>
    </joint>
    <!-- 左侧夹爪关节，跟随 gripper_controller -->
    <joint name="gripper_base_to_gripper_left2">
      <!-- 跟随主夹爪关节 -->
      <param name="mimic">gripper_controller</param>
      <!-- 运动方向与主关节相同 -->
      <param name="multiplier">1.0</param>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
      <!-- 读取当前关节速度 -->
      <state_interface name="velocity"/>
    </joint>
    <!-- 左侧夹爪关节，跟随 gripper_controller -->
    <joint name="gripper_left3_to_gripper_left1">
      <!-- 跟随主夹爪关节 -->
      <param name="mimic">gripper_controller</param>
      <!-- 运动方向与主关节相反 -->
      <param name="multiplier">-1.0</param>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
      <!-- 读取当前关节速度 -->
      <state_interface name="velocity"/>
    </joint>
    <!-- 右侧夹爪关节，跟随 gripper_controller -->
    <joint name="gripper_base_to_gripper_right3">
      <!-- 跟随主夹爪关节 -->
      <param name="mimic">gripper_controller</param>
      <!-- 运动方向与主关节相反 -->
      <param name="multiplier">-1.0</param>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
      <!-- 读取当前关节速度 -->
      <state_interface name="velocity"/>
    </joint>
    <!-- 右侧夹爪关节，跟随 gripper_controller -->
    <joint name="gripper_base_to_gripper_right2">
      <!-- 跟随主夹爪关节 -->
      <param name="mimic">gripper_controller</param>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
      <!-- 读取当前关节速度 -->
      <state_interface name="velocity"/>
    </joint>
    <!-- 右侧夹爪关节，跟随 gripper_controller -->
    <joint name="gripper_right3_to_gripper_right1">
      <!-- 跟随主夹爪关节 -->
      <param name="mimic">gripper_controller</param>
      <!-- 运动方向与主关节相同 -->
      <param name="multiplier">1.0</param>
      <!-- 读取当前关节位置 -->
      <state_interface name="position"/>
      <!-- 读取当前关节速度 -->
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- 7. 引入D435i深度相机模型文件，仅include，是否启用由use_camera控制（当前代码未做相机if判断） -->
  <!-- <xacro:include filename="$(find mycobot_description)/urdf/sensors/intel_rgbd_cam_d435.urdf.xacro"/> -->
</robot>
